# Configurações de Servidor IMAP (Leitura de E-mails)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seu_email@gmail.com
IMAP_PASSWORD=sua_senha_de_app

# Configurações de Servidor SMTP (Envio de E-mails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_USE_TLS=true

# Diretórios para Organização dos Anexos
DIR_DOCUMENTOS_OK=Documentos_OK
DIR_PENDENTES=Pendentes
DIR_ARQUIVADOS=Arquivados

# Planilha Mestra (Excel)
PLANILHA_MESTRA_PATH=output/planilha_mestra.xlsx

